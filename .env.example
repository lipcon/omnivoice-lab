PORT=8000
OMNIVOICE_MODEL=k2-fsa/OmniVoice

# Which physical GPU to hand the container, as nvidia-smi numbers it.
# The container sees only this card, so it stays cuda:0 inside.
GPU_ID=5

# Leave at cuda:0 unless GPU_ID=all, which exposes every card.
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_DTYPE=float16

# Language of the reference clips, for the transcript Whisper writes when you
# upload one without text. Empty means auto-detect, which on a short or
# atypical clip can pick the wrong language silently.
OMNIVOICE_LANGUAGE=it

# Put Whisper somewhere else, e.g. cpu, to keep the generation GPU free.
# Empty means the same device as the model.
OMNIVOICE_ASR_DEVICE=

# Uncomment if huggingface.co is slow or blocked:
# HF_ENDPOINT=https://hf-mirror.com
